theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 26
text = "PAUSED"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Root/Center/Panel/Box"]
layout_mode = 2
alignment = 1
