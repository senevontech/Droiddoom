[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://ui/theme/holo_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://ui/hud/widgets/frost_panel.gd" id="3_frame"]

[sub_resource type="ButtonGroup" id="fire_group"]

[node name="PauseMenu" type="CanvasLayer"]
layer = 60
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.02, 0.03, 0.3)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="MarginContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/margin_left = 36
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 36
theme_override_constants/margin_bottom = 26
script = ExtResource("3_frame")
corner_radius = 18.0
shade = 0.3

[node name="Box" type="VBoxContainer" parent="Root/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/Center/Panel/Box"]
