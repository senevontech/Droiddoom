[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="player_projectiles"
3d_physics/layer_4="enemies"
3d_physics/layer_5="enemy_projectiles"
3d_physics/layer_6="pickups"
3d_physics/layer_7="allies"
3d_physics/layer_8="triggers"
3d_physics/layer_9="camera_occluders"
3d_physics/layer_10="navigation_only"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=4

[shader_globals]

occlusion_target={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
occlusion_radius={
"type": "float",
"value": 0.0
}
