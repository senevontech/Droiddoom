# Normalize line endings (Godot and GDScript use LF)
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# ---- Git LFS: large binary assets ----
# 3D
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf text eol=lf
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# *.blend: kept OUTSIDE the repo (D-023), see .gitignore
# Textures / images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
# Video
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.lmbake filter=lfs diff=lfs merge=lfs -text

# ---- Exceptions: plain git files, not LFS ----
# Third-party addons (GUT): CI checks out without LFS, and the test runner
# needs its own fonts and icons, or it logs font errors that fail the tests.
game/addons/** -filter -diff -merge
# Generated placeholder SFX (tools/gen_sfx.py, ~340 KB): plain git so CI
# (no LFS) imports real audio. Real recordings later may go back to LFS.
game/assets/audio/sfx/** -filter -diff -merge
# Small UI images (boot splash, rendered by us): plain git so CI imports them.
game/assets/ui/** -filter -diff -merge
# Bundled OFL fonts (~830 KB): plain git so CI (no LFS) has real fonts.
game/assets/fonts/** -filter -diff -merge
